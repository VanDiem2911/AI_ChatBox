# ==========================================
# MONGODB DATABASE CONFIGURATION
# ==========================================
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=smartconsult_ai

# ==========================================
# OPENAI API CONFIGURATION
# ==========================================
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ==========================================
# GOOGLE GEMINI API CONFIGURATION
# ==========================================
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768

# ==========================================
# AUTHENTICATION & SECURITY
# ==========================================
AUTH_SECRET=change-this-to-a-super-secret-random-key-in-production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# ADMIN DEFAULT CREDENTIALS (FOR SEEDING)
# ==========================================
ADMIN_EMAIL=admin@smartconsult.ai
ADMIN_PASSWORD=AdminSecurePass123!
